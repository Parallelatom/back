# Copy to telegram-secrets.env on the VPS and chmod 600 before filling.
#
# Deliberately separate from execution-secrets.env. The monitor needs neither a private
# key nor an Authorization value — it only reads and writes ledgers — so it should not be
# a process that happens to have them in its environment.
#
# Token from @BotFather. Chat id from:
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | python3 -m json.tool
export NINELIVES_TELEGRAM_TOKEN=
export NINELIVES_TELEGRAM_CHAT_ID=
