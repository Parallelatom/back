# Copy to execution-secrets.env on the VPS and chmod 600 before filling.
# Paste each FULL Authorization value inside single quotes. Do not add Bearer.
# Only run_live --execute transmits Authorization or broadcasts signed claims.
# Private keys are for dedicated bot wallets matching the public addresses.
# Never paste a seed phrase here. Never send these values in chat or commit them.
export NINELIVES_BTC_AUTHORIZATION=''
export NINELIVES_XYZCL_AUTHORIZATION=''
export NINELIVES_BTC_PRIVATE_KEY=''
export NINELIVES_XYZCL_PRIVATE_KEY=''
