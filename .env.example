# Copy to .env on the VPS and fill in. .env is gitignored: the token is a credential.
#
# Create the tunnel in the Cloudflare dashboard under
#   Zero Trust -> Networks -> Tunnels -> Create a tunnel -> Cloudflared
# and paste the token it shows here. Routing and access rules are configured there too;
# see the README.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: where the dashboard is published on the host's loopback interface.
# Only matters for the `ssh -L` route; the tunnel does not use it. Default 8000.
STRATEGY_LAB_HOST_PORT=8000
